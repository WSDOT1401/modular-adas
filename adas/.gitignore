# The modular ADAS. Kept here (not in the repo-root .gitignore) so the rules
# live next to the files they apply to.

# --- Python cache and packaging (editable install of protocol/) ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.env

# --- Vision sample media / replay clips (keep the dir, not the footage) ---
vision/tests/fixtures/*
!vision/tests/fixtures/.gitkeep

# --- ML weights / sample media / inference outputs ---
# Raw weights and media are never committed (models/manifests/ records their
# metadata); benchmark CSVs under experiments/ are tracked.
*.pt
*.jpg
*.mp4
runs/

# --- Traffic-sign experiment (experiments/traffic-sign_recognition) ---
# Generated YOLO datasets: the PNG cache and per-label-set labels. Fully
# rebuildable from GTSDB with prepare_gtsdb.py, so not worth versioning.
experiments/traffic-sign_recognition/datasets/
# results/ IS tracked, via Git LFS (see .gitattributes). The blanket *.pt rule
# above would otherwise silently swallow the trained weights.
!experiments/traffic-sign_recognition/results/**/*.pt
gtsdb-dataset/
# Frame-curation web app: raw footage and the regenerable frame cache. The
# blanket *.mp4 / *.jpg rules above miss .mov/.mkv/.mts and workspace metadata.
experiments/traffic-sign_recognition/dataset_builder/footage/*
!experiments/traffic-sign_recognition/dataset_builder/footage/.gitkeep
experiments/traffic-sign_recognition/dataset_builder/workspace/

# Contents only, so extractor.py stays tracked -- git never descends into an
# excluded directory, so ignoring the directory itself would make the
# negation below unreachable.
experiments/traffic-sign_recognition/thai-traffic-sign-labs/datasets/*
!experiments/traffic-sign_recognition/thai-traffic-sign-labs/datasets/extractor.py
# Generated audit figures (~15 MB). qa/*.py stay tracked.
experiments/traffic-sign_recognition/thai-traffic-sign-labs/qa/out/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/results/*
# autolabel scratch
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/work/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/golden-experiment/work/
# autolabel pipeline: raw footage, the regenerable frame+score cache, the
# batches (images) and the built dataset. app/notebook.json is NOT ignored --
# it records which frames a human picked, which is real dataset provenance.
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/app/footage/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/app/workspace/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/batches/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/dataset/
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/*.zip
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/predictions.csv
experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/results/*
# ...but the little script that runs the trained model over new footage is code.
!experiments/traffic-sign_recognition/thai-traffic-sign-labs/autolabel/results/*.py

# Training logs. NOT a blanket *.txt -- CMakeLists.txt and three
# requirements.txt are tracked. The runs are not reproducible anyway (synth.py
# draws new data every epoch); what the logs taught is in the classifier README.
train_log_*.txt

# Beep/alert audio prototyping: ~20 generated wavs plus a notebook that is
# still scratch. Promote it out of here when it becomes a service.
experiments/sign_beep/
experiments/pi_recording/footage-test
experiments/pi_recording/footage

# --- experiments/central: the two models that ship ---
# These are the deliverable, not a by-product -- `central/` is what gets copied
# to the Pi, so it has to survive a plain `git clone`. 11 MB total, both files
# far under GitHub's 100 MB per-file limit, so normal git carries them. NOT LFS:
# a colleague without git-lfs would clone 130-byte pointer files that look like
# weights and fail at load time, which is the exact problem this rule fixes.
!experiments/central/*.pt
