list.txt

# --- Local runtime state / logs ---
*.log
*.tmp
*.bak

# --- Python cache (pi helpers) ---
__pycache__/
*.py[cod]
qt_cluster/state.json

# --- AI assistant local guidance (not committed) ---
CLAUDE.md

