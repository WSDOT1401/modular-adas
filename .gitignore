# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- VS Code local workspace state ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# --- CMake / C++ build outputs ---
**/build/
**/build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
install_manifest.txt

# --- Qt generated/autogen artifacts ---
**/*_autogen/
**/*_qmltyperegistrations.cpp
**/.qt/
**/.qt_plugins/
**/.generated/
**/.rcc/

# --- Qt deployment/runtime copied binaries & plugins ---
apps/cluster/build-*/**/*.dll
apps/cluster/build-*/generic/
apps/cluster/build-*/iconengines/
apps/cluster/build-*/imageformats/
apps/cluster/build-*/networkinformation/
apps/cluster/build-*/platforms/
apps/cluster/build-*/qml/
apps/cluster/build-*/qmltooling/
apps/cluster/build-*/qmltypes/
apps/cluster/build-*/tls/
apps/cluster/build-*/translations/
apps/cluster/build-*/W124Cluster/

# --- Node.js tooling (PNG generation scripts, etc.) ---
node_modules/
package-lock.json

# --- Scratch / temp files ---
list.txt

# --- Local runtime state / logs ---
*.log
*.tmp
*.bak

# --- Python cache (pi helpers) ---
__pycache__/
*.py[cod]
apps/cluster/state.json

# --- AI assistant local guidance (not committed) ---
CLAUDE.md

# --- Python packaging (editable installs of libs/) ---
*.egg-info/
.eggs/

# --- Vision sample media / replay clips (keep the dir, not the footage) ---
services/vision/tests/fixtures/*
!services/vision/tests/fixtures/.gitkeep

# --- Runtime IPC files (generated; shared between producers and cluster) ---
carplay_status.json
trip_reset.flag

# --- ML weights / sample media / inference outputs (experiments, models, vision) ---
# Raw weights & media are never committed (see models/manifests/ for their metadata);
# benchmark CSVs under experiments/ are tracked.
*.pt
*.jpg
*.mp4
runs/
.env
# --- Traffic-sign experiment (experiments/traffic-sign_recognition) ---
# Generated YOLO datasets: the PNG cache and per-label-set labels. Fully
# rebuildable from GTSDB with prepare_gtsdb.py, so not worth versioning.
experiments/traffic-sign_recognition/datasets/
# results/ IS tracked, via Git LFS (see .gitattributes). The blanket *.pt rule
# above would otherwise silently swallow the trained weights.
!experiments/traffic-sign_recognition/results/**/*.pt
gtsdb-dataset/
# Frame-curation web app: raw footage and the regenerable frame cache. The
# blanket *.mp4 / *.jpg rules above miss .mov/.mkv/.mts and workspace metadata.
experiments/traffic-sign_recognition/dataset_builder/footage/*
!experiments/traffic-sign_recognition/dataset_builder/footage/.gitkeep
experiments/traffic-sign_recognition/dataset_builder/workspace/
# Contents only, so extractor.py stays tracked -- git never descends into an
# excluded directory, so ignoring the directory itself would make the
# negation below unreachable.
experiments/traffic-sign_recognition/thai-traffic-sign-labs/datasets/*
!experiments/traffic-sign_recognition/thai-traffic-sign-labs/datasets/extractor.py
# Generated audit figures (~15 MB). qa/*.py stay tracked.
experiments/traffic-sign_recognition/thai-traffic-sign-labs/qa/out/
