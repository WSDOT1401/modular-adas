# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- VS Code local workspace state ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# --- CMake / C++ build outputs ---
**/build/
**/build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
install_manifest.txt

# --- Qt generated/autogen artifacts ---
**/*_autogen/
**/*_qmltyperegistrations.cpp
**/.qt/
**/.qt_plugins/
**/.generated/
**/.rcc/

# --- Node.js dependencies ---
node_modules/
package-lock.json

# --- Scratch / temp files ---
list.txt

# --- Local runtime state / logs ---
*.log
*.tmp
*.bak

# --- Python cache ---
__pycache__/
*.py[cod]

# --- AI assistant local guidance (not committed) ---
CLAUDE.md

# Folder-specific rules live next to their files: adas/.gitignore (weights,
# datasets, footage, editable installs) and w124/.gitignore (Qt deploy output,
# runtime IPC files, CarPlay node_modules).
