# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- VS Code local workspace state ---
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# --- CMake / C++ build outputs ---
**/build/
**/build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
CTestTestfile.cmake
install_manifest.txt

# --- Qt generated/autogen artifacts ---
**/*_autogen/
**/*_qmltyperegistrations.cpp
**/.qt/
**/.qt_plugins/
**/.generated/
**/.rcc/

# W124-specific rules (Qt deploy output, runtime IPC files) live in w124/.gitignore.

# --- Node.js tooling (PNG generation scripts, etc.) ---
node_modules/
package-lock.json

# --- Scratch / temp files ---
list.txt

# --- Local runtime state / logs ---
*.log
*.tmp
*.bak

# --- Python cache (pi helpers) ---
__pycache__/
*.py[cod]

# --- AI assistant local guidance (not committed) ---
CLAUDE.md

# --- Python packaging (editable installs, e.g. adas/protocol) ---
*.egg-info/
.eggs/

# --- Vision sample media / replay clips (keep the dir, not the footage) ---
adas/vision/tests/fixtures/*
!adas/vision/tests/fixtures/.gitkeep

# --- ML weights / sample media / inference outputs (experiments, models, vision) ---
# Raw weights & media are never committed (see models/manifests/ for their metadata);
# benchmark CSVs under experiments/ are tracked.
*.pt
*.jpg
*.mp4
runs/
.env
# --- Traffic-sign experiment (experiments/traffic-sign_recognition) ---
# Generated YOLO datasets: the PNG cache and per-label-set labels. Fully
# rebuildable from GTSDB with prepare_gtsdb.py, so not worth versioning.
experiments/traffic-sign_recognition/datasets/
# results/ IS tracked, via Git LFS (see .gitattributes). The blanket *.pt rule
# above would otherwise silently swallow the trained weights.
!experiments/traffic-sign_recognition/results/**/*.pt
gtsdb-dataset/
# Frame-curation web app: raw footage and the regenerable frame cache. The
# blanket *.mp4 / *.jpg rules above miss .mov/.mkv/.mts and workspace metadata.
experiments/traffic-sign_recognition/dataset_builder/footage/*
!experiments/traffic-sign_recognition/dataset_builder/footage/.gitkeep
experiments/traffic-sign_recognition/dataset_builder/workspace/
