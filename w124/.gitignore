# W124 vehicle integration. Kept here (not in the repo-root .gitignore) so this
# folder stays self-contained if it is ever split into its own repository.

# --- Qt / CMake build output (cluster) ---
build/
build-*/
*_autogen/
CMakeCache.txt
CMakeFiles/

# --- Qt deployment/runtime copied binaries & plugins ---
cluster/build-*/**/*.dll
cluster/build-*/generic/
cluster/build-*/iconengines/
cluster/build-*/imageformats/
cluster/build-*/networkinformation/
cluster/build-*/platforms/
cluster/build-*/qml/
cluster/build-*/qmltooling/
cluster/build-*/qmltypes/
cluster/build-*/tls/
cluster/build-*/translations/
cluster/build-*/W124Cluster/

# --- Runtime state and IPC files (generated; shared between producers and cluster) ---
cluster/state.json
carplay_status.json
trip_reset.flag

# --- Node dependencies (CarPlay bridge, asset scripts) ---
node_modules/
package-lock.json

# --- Python cache (vss reader) ---
__pycache__/
*.py[cod]
